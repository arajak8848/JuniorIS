@article{Juan,
  author = {Juan Ungredda and Juergen Branke},
  title = {Bayesian Optimisation for Constrained Problems},
  volume = {ACM Transactions on Modeling and Computer Simulation, Volume 34, Issue 2},
  year = {2024},
  url = {https://dl.acm.org/doi/10.1145/3641544},
  annote = {The paper introduces a constrained variant of the Knowledge Gradient acquisition function for 
  Bayesian optimisation to handle expensive black-box problems with constraints. It uses a Gaussian process 
  surrogate to sequentially select evaluations, empirically outperforming four state-of-the-art constrained BO 
  methods, and proves convergence to the true optimum in the infinite budget limit.}
}

@article{aitor,
  author = {Aitor Morais, Eneko Osaba, Iker Pastor, Izaskun Oregi},
  title = {Comparative Analysis of Classical and Quantum-Inspired Solvers: A Preliminary Study on the Weighted Max-Cut Problem},
  volume = {GECCO '25 Companion: Proceedings of the Genetic and Evolutionary Computation Conference Companion Pages 2449 - 2457},
  year = {2025},
  url ={https://dl.acm.org/doi/10.1145/3712255.3734363},
  annote = {This study compares three paradigms for solving the Weighted Max-Cut problem: a Genetic Algorithm, a 
  Graph Neural Network, and a tensor network approach using Density Matrix Renormalization Group. Evaluating graphs 
  from 10 to 250 nodes, it analyzes solution quality, runtime, and memory usage. Results show trade-offs in 
  scalability, efficiency, and approximation performance.}
}

@article{faro,
  author = {Simone Faro, Francesco Pio Marino},
  title = {Scaling Grover’s Search for Large Solution Spaces},
  volume = {HPDC '25: Proceedings of the 34th International Symposium on High-Performance Parallel and Distributed Computing},
  year = {2025},
  url = {https://dl.acm.org/doi/10.1145/3731545.3744149},
  annote = {This work improves Grover’s algorithm for cases where valid solutions exceed half the search space, 
  a regime where performance typically degrades. By virtually expanding the domain with auxiliary qubits and 
  modifying the oracle, the method reduces effective solution density without increasing circuit depth. 
  Simulations confirm improved reliability while preserving Grover’s optimal asymptotic complexity.}
}

@article{magdy,
  author = {Amr Magdy},
  title = {Quantum Optimization Realized: Quantum Annealing for Combinatorial Spatial Problems in Practice},
  volume = {Q-Spatial '25: Proceedings of the 1st ACM SIGSPATIAL International Workshop on Quantum Computing for Spatial Data Systems and Applications},
  year = {2026},
  url = {https://dl.acm.org/doi/10.1145/3764923.3777407},
  annote ={This manuscript summarizes D-Wave’s keynote on quantum annealing as a practical approach to 
  combinatorial optimization. It highlights D-Wave’s QPUs for solving QUBO models and hybrid quantum-classical 
  systems. Applications across academia and industry demonstrate that quantum annealing has matured into a 
  production-ready technology delivering real-world optimization value.}
}

